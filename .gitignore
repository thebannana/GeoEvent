############################################################
# GeoEvent repository .gitignore
############################################################

############################################################
# OS / EDITOR / TEMPORARY FILES
############################################################

.DS_Store
Thumbs.db
desktop.ini

*.tmp
*.temp
*~
*.swp
*.swo
*.bak
*.cache
*.log

logs/

############################################################
# .NET / ASP.NET / C# BUILD OUTPUT
############################################################

**/[Bb]in/
**/[Oo]bj/
**/[Dd]ebug/
**/[Rr]elease/
**/publish/
**/out/
**/dist/
**/coverage/
**/app.publish/

*.pdb
*.mdb

############################################################
# VISUAL STUDIO / IDE
############################################################

.vs/
**/.vs/

.vscode/
**/.vscode/

.idea/
**/.idea/

*.user
*.suo
*.userosscache
*.sln.docstates

_ReSharper*/
**/_ReSharper*/

*.DotSettings.user

############################################################
# ASP.NET / LOCAL DEVELOPMENT
############################################################

iisexpress/

############################################################
# FLUTTER / DART
############################################################

**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/doc/api/

# iOS generated/local files
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Flutter/App.framework/
**/ios/Flutter/Flutter.framework/

# Android generated/local files
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/key.properties
**/android/*.jks
**/android/*.keystore

# Uncomment only if these files are generated in your project:
# **/*.g.dart
# **/*.freezed.dart

############################################################
# NODE / JAVASCRIPT TOOLING
############################################################

**/node_modules/
**/.angular/
**/.angular/cache/
**/.sass-cache/
**/.eslintcache
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

############################################################
# LOCAL DATABASE FILES
############################################################

**/*.mdf
**/*.ldf
**/*.db
**/*.sqlite
**/*.sqlite3

############################################################
# SECRETS / ENVIRONMENT / SIGNING FILES
############################################################

.env
.env.*
**/.env
**/.env.*

!.env.example

**/appsettings.Development.json
**/secrets.json
**/secrets/

**/*.pfx
**/*.p12
**/*.pem
**/*.key

**/.env-tajne.zip

############################################################
# TEST / ANALYSIS OUTPUT
############################################################

**/*.trx
**/*.coverage
**/TestResults/
**/.sonarqube/

############################################################
# LOCAL INFRASTRUCTURE DATA
############################################################

**/docker-data/

# Ignore Kubernetes secret manifests.
**/k8s/secrets*.yaml
**/k8s/*secret*.yaml