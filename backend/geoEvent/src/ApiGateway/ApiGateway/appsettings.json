{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SecretKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-public-profiles-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/public"
        }
      },
      "users-public-profile-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{userId:int}/public"
        }
      },
      "users-reviews-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{userId:int}/reviews"
        }
      },
      "users-profiles-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/profiles"
        }
      },
      "users-admin-ban-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/users/{userId:int}/ban"
        }
      },
      "users-admin-unban-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/users/{userId:int}/unban"
        }
      },
      "users-admin-list-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/users",
          "Methods": [ "GET" ]
        }
      },
      "preferences-mine-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/preferences",
          "Methods": [ "GET" ]
        }
      },
      "preferences-admin-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/preferences/users/{userId:int}",
          "Methods": [ "GET" ]
        }
      },
      "reports-create-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/reports",
          "Methods": [ "POST" ]
        }
      },
      "reports-my-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/reports/my",
          "Methods": [ "GET" ]
        }
      },
      "reports-status-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/reports/{reportId:int}/status",
          "Methods": [ "POST" ]
        }
      },
      "reports-by-id-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/reports/{reportId:int}",
          "Methods": [ "GET" ]
        }
      },
      "reports-admin-list-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/reports",
          "Methods": [ "GET" ]
        }
      },
      "admin-dashboard-users-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/dashboard/users",
          "Methods": [ "GET" ]
        }
      },
      "admin-dashboard-events-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/dashboard/events",
          "Methods": [ "GET" ]
        }
      },
      "admin-dashboard-tickets-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/dashboard/tickets",
          "Methods": [ "GET" ]
        }
      },
      "admin-events-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/events/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "admin-comments-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/admin/comments/{**catch-all}",
          "Methods": [ "PUT", "DELETE" ]
        }
      },
      "users-authenticated-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "public-events-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/public/events/{**catch-all}"
        }
      },
      "event-tickets-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 0,
        "Match": {
          "Path": "/api/events/{eventId:int}/tickets/{**catch-all}"
        }
      },
      "event-reservations-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": {
          "Path": "/api/events/{eventId:int}/reservations/{**catch-all}"
        }
      },
      "events-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 100,
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "bookmarks-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/bookmarks/{**catch-all}"
        }
      },
      "comments-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "segments-read-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/segments/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "segments-write-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/segments/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "genres-read-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/genres/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "genres-write-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/genres/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "subgenres-read-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/subgenres/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "subgenres-write-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/subgenres/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "uploads-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/uploads/{**catch-all}"
        }
      },
      "tickets-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        }
      },
      "reservations-refund-requests-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "admin",
        "Order": 0,
        "Match": {
          "Path": "/api/reservations/refund-requests",
          "Methods": [ "GET" ]
        }
      },
      "reservations-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 100,
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "chat-route": {
        "ClusterId": "message-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "message-hub-route": {
        "ClusterId": "message-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/hubs/chat/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": ""
          }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event-service": {
            "Address": ""
          }
        }
      },
      "ticket-cluster": {
        "Destinations": {
          "ticket-service": {
            "Address": ""
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": ""
          }
        }
      },
      "message-cluster": {
        "Destinations": {
          "message-service": {
            "Address": ""
          }
        }
      }
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/auth/*",
        "Period": "5m",
        "Limit": 10
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  }
}