{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SecretKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "preferences-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/preferences/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },

      "public-events-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/public/events/{**catch-all}"
        }
      },
      "public-venues-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/public/venues/{**catch-all}"
        }
      },

      "event-tickets-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 0,
        "Match": {
          "Path": "/api/events/{eventId:int}/tickets/{**catch-all}"
        }
      },
      "event-reservations-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 1,
        "Match": {
          "Path": "/api/events/{eventId:int}/reservations/{**catch-all}"
        }
      },
      "events-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 100,
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },

      "bookmarks-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/bookmarks/{**catch-all}"
        }
      },
      "comments-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "venues-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/venues/{**catch-all}"
        }
      },
      "segments-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/segments/{**catch-all}"
        }
      },
      "genres-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/genres/{**catch-all}"
        }
      },
      "uploads-route": {
        "ClusterId": "event-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/uploads/{**catch-all}"
        }
      },

      "tickets-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },

      "notifications-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },

      "chat-route": {
        "ClusterId": "message-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "message-hub-route": {
        "ClusterId": "message-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/hubs/chat/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": ""
          }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event-service": {
            "Address": ""
          }
        }
      },
      "ticket-cluster": {
        "Destinations": {
          "ticket-service": {
            "Address": ""
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": ""
          }
        }
      },
      "message-cluster": {
        "Destinations": {
          "message-service": {
            "Address": ""
          }
        }
      }
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/auth/*",
        "Period": "5m",
        "Limit": 10
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  }
}