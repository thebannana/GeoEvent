<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.13" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\UserService\UserService.Infrastructure\UserService.Infrastructure.csproj" />
		<ProjectReference Include="..\..\EventService\EventService.Infrastructure\EventService.Infrastructure.csproj" />
		<ProjectReference Include="..\..\MessageService\MessageService.Infrastructure\MessageService.Infrastructure.csproj" />
		<ProjectReference Include="..\..\NotificationService\NotificationService.Infrastructure\NotificationService.Infrastructure.csproj" />
		<ProjectReference Include="..\..\TicketService\TicketService.Infrastructure\TicketService.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="Always" />
		<None Update="appsettings.*.json"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="Always" />
	</ItemGroup>
</Project>